# Optional — enables the AI narration layer. Without it, every deterministic
# feature works and AI endpoints degrade gracefully (available: false).
# Never commit a real key (§28.2).
ANTHROPIC_API_KEY=

# Optional overrides
# EQUISENSE_DB=sqlite:///data/equisense.db

# ---------------------------------------------------------------- deployment
# Hosted database (Neon Postgres). When set, EVERYTHING persistent lives in the
# database — market data, the hash-chained ledger and the raw vault — because
# Vercel's filesystem is ephemeral and is wiped on every cold start.
# Neon hands out postgres:// or postgresql:// URLs; both are rewritten to
# postgresql+psycopg:// automatically. Use the POOLED connection string on
# serverless: each cold start opens a new connection and the pooler is what
# keeps you inside Neon's connection limit.
DATABASE_URL=

# Gate the whole app behind a shared token (recommended for a public URL).
# Without it the deployment is world-readable.
EQUISENSE_ACCESS_TOKEN=

# Where the ledger and raw vault live: "db" (default on Postgres) or "file"
# (default on SQLite). Do not set this to "file" on Vercel — the writes vanish.
# EQUISENSE_STORAGE=db

# Set to 1 on a hosted deployment so the labelled DEMO dataset is never seeded.
# (Seeding is now disabled outright regardless; this is belt-and-braces.)
EQUISENSE_AUTO_INGEST=1

# Live-data mode (README §3.1a). "1" = fetch market prices live from Yahoo and
# cache in-process; NOTHING bulk is written to the database, so the free-tier
# transfer allowance is never exhausted and the data cannot go stale. Default is
# ON in a hosted serverless environment and OFF locally (dev/tests stay offline);
# set to 0 to force the classic stored-panel mode even when hosted.
EQUISENSE_LIVE_DATA=1
