+        if ts_dt.tzinfo is not None:
+            ts_dt = ts_dt.replace(tzinfo=None)
+        age_days = (datetime.utcnow() - ts_dt).total_seconds() / 86400.0
+        return age_days <= max_age_days
+    except Exception:                                  # noqa: BLE001
+        return True
